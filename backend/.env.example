# Copy to .env and adjust for your environment.

# Local dev default: SQLite, zero setup.
# Render deployment: set to the managed Postgres URL, e.g.
#   postgresql+psycopg://user:pass@host/dbname
# If the native psycopg driver can't load (locked-down Windows machine),
# swap the scheme to postgresql+pg8000:// instead -- same credentials.
DATABASE_URL=sqlite:///./attendance.db

# Must be overridden to a long random value in any shared/deployed environment.
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Comma-separated list of allowed frontend origins (CORS).
# e.g. http://localhost:5173,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173
